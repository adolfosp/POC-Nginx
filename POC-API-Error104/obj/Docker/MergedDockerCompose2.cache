      dockerfile: POC-API-Error104/Dockerfile
    deploy:
      resources:
        limits:
          cpus: 0.3
          memory: "268435456"
        reservations:
          cpus: 0.2
          memory: "134217728"
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "8080"
      ASPNETCORE_HTTPS_PORTS: "8081"
    image: pocapierror104
    networks:
